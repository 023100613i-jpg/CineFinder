# ===== Copia este archivo como ".env" y rellena tus valores =====

# APIs externas
TMDB_API_KEY=pon_aqui_tu_clave_de_tmdb
OMDB_API_KEY=pon_aqui_tu_clave_de_omdb
GROQ_API_KEY=pon_aqui_tu_clave_de_groq

# Base de datos PostgreSQL (local: postgresql://usuario:clave@localhost:5432/cinefinder)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinefinder

# Seguridad: una frase larga y aleatoria (NO la compartas)
JWT_SECRET=cambia_esto_por_una_frase_larga_y_aleatoria

# Primer administrador (se crea automáticamente al iniciar si no existe)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@cinefinder.com
ADMIN_PASSWORD=CambiaEstaClave123

# Solo en producción (Render ya lo pone solo): NODE_ENV=production
